{
  "name": "yoi-ichinichi",
  "version": "0.1.0",
  "private": true,
  "description": "よい一日のはじまりに — 離れて暮らす親に毎朝LINEで挨拶を届け、返信がなければ家族に知らせる見守り",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "db:init:local": "wrangler d1 migrations apply yoi-ichinichi --local",
    "db:init:remote": "wrangler d1 migrations apply yoi-ichinichi --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
